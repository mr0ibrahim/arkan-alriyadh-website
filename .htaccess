# Hostinger Git auto-deploy copies this branch (Astro source) into the
# document root without building it. Serve the prebuilt site from dist/
# instead. Rebuild with: npm run build, then commit dist/ (git add -f dist).
# Once Hostinger deploys the "deploy" branch, this file and dist/ can go.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: redirect www to the bare domain
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Visitors asking for /dist/... get the clean URL
  RewriteCond %{THE_REQUEST} \s/+dist/(\S*)\s
  RewriteRule ^ /%1 [R=301,L]

  # Already mapped into dist/
  RewriteRule ^dist/ - [L]

  # Add the trailing slash for page directories (/services -> /services/)
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

  # Everything else (pages, assets, robots.txt, sitemap.xml) comes from dist/;
  # source files such as README.md or package.json are no longer exposed.
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>
