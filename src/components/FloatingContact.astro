---
import { contactLink, callLink } from '../data/site';
const message = contactLink();
---

<aside
  class="fixed bottom-5 left-5 z-40 flex items-center gap-2 rounded-full border border-wood/20 bg-white/95 p-1.5 shadow-2xl backdrop-blur-md transition-all duration-300"
  aria-label="تواصل فوري سريع"
>
  <!-- WhatsApp Button -->
  <a
    href={message}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2 rounded-full bg-[#1A7A4C] px-4 py-2.5 text-xs font-black text-white shadow-xs transition duration-200 hover:bg-[#14603B] hover:shadow-md sm:text-sm"
    aria-label="مراسلة سريعة عبر واتساب"
  >
    <svg class="h-4 w-4 text-white" fill="currentColor" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
    </svg>
    <span>واتساب</span>
  </a>

  <!-- Phone Call Button -->
  <a
    href={callLink}
    class="flex items-center gap-1.5 rounded-full border border-wood/25 bg-ivory/80 px-4 py-2.5 text-xs font-black text-wood shadow-2xs transition duration-200 hover:border-wood hover:bg-wood hover:text-white sm:text-sm"
    aria-label="الاتصال الهاتفي المباشر"
  >
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
    </svg>
    <span>اتصال</span>
  </a>
</aside>
