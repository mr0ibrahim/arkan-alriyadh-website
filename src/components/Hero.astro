---
const whatsapp =
  'https://wa.me/966533340982?text=' +
  encodeURIComponent(
    'السلام عليكم، أرغب في الاستفسار عن خدمات أركان الرياض للتصميم الداخلي.'
  );
---

<section
  id="home"
  class="relative overflow-hidden bg-ivory"
>
  <div
    class="pointer-events-none absolute -left-32 top-12 h-80 w-80 rounded-full bg-gold/15 blur-3xl"
    aria-hidden="true"
  ></div>

  <div
    class="relative mx-auto grid min-h-[580px] max-w-7xl items-center gap-12 px-5 py-16 lg:grid-cols-2 lg:py-24"
  >
    <div class="order-2 lg:order-1">
      <span
        class="mb-6 inline-flex rounded-full border border-gold/40 bg-white/70 px-5 py-2 text-sm font-bold text-wood"
      >
        12 عامًا من الخبرة في الديكور
      </span>

      <h1
        class="mb-7 text-4xl font-extrabold leading-[1.6] text-charcoal md:text-5xl"
      >
        أركان الرياض
        <span class="block text-wood">
          نصنع جمال التفاصيل
        </span>
      </h1>

      <p class="mb-8 max-w-xl text-base leading-9 text-charcoal/75">
        متخصصون في التصميم والتنفيذ والتركيب لأعمال
        الديكور الداخلي في الرياض، مع توريد المواد
        إلى جميع محافظات المملكة.
        نقدم حلولًا متنوعة تناسب ذوقك ومساحتك.
      </p>

      <div class="flex flex-wrap gap-3">
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-wood px-7 py-4 font-bold text-white transition hover:bg-charcoal"
        >
          تواصل عبر واتساب
        </a>

        <a
          href="/#services"
          class="rounded-full border border-wood px-7 py-4 font-bold text-wood transition hover:bg-wood hover:text-white"
        >
          اكتشف خدماتنا
        </a>
      </div>

      <div class="mt-12 flex flex-wrap gap-10 border-t border-wood/15 pt-7">
        <div>
          <strong class="block text-3xl text-wood">12+</strong>
          <span class="text-sm text-charcoal/65">سنة خبرة</span>
        </div>

        <div>
          <strong class="block text-3xl text-wood">5</strong>
          <span class="text-sm text-charcoal/65">خدمات ديكور</span>
        </div>
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <div
        class="relative flex min-h-[350px] items-center justify-center overflow-hidden rounded-[2rem] border border-gold/30 bg-gradient-to-br from-[#E5D5BD] via-[#F6F0E6] to-[#C7A775] p-8 shadow-xl shadow-wood/10 lg:min-h-[520px]"
      >
        <div class="absolute inset-5 rounded-[1.5rem] border border-white/60"></div>

        <div class="relative text-center">
          <div class="mb-5 text-7xl font-black text-wood/50" aria-hidden="true">
            أ
          </div>

          <p class="text-3xl font-extrabold text-wood">
            أركان الرياض
          </p>

          <p class="mt-3 text-sm tracking-wide text-charcoal/70">
            للتصميم الداخلي والاستشارات
          </p>

          <p class="mt-8 text-xs text-charcoal/60">
            ستوضع هنا الصورة الرئيسية المرخّصة
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
