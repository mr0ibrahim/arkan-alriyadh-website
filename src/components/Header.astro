---
import { site, contactLink, callLink } from '../data/site';
const whatsapp = contactLink();
---

<header class="sticky top-0 z-50 border-b border-wood/10 bg-ivory/95 backdrop-blur-md transition-all duration-300">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:py-4">
    <!-- Brand Logo & Name -->
    <a href="/" class="group flex items-center gap-3 transition-opacity hover:opacity-90" aria-label={`${site.name} - الرئيسية`}>
      <div class="relative overflow-hidden rounded-xl border border-gold/30 bg-white p-1 shadow-sm transition group-hover:border-gold">
        <img
          src="/images/arkan-symbol.webp"
          alt=""
          aria-hidden="true"
          width="44"
          height="44"
          decoding="async"
          class="h-10 w-10 sm:h-11 sm:w-11 object-contain"
        />
      </div>
      <div class="flex flex-col">
        <span class="text-base font-black tracking-tight text-wood sm:text-lg lg:text-xl">
          {site.name}
        </span>
        <span class="hidden text-xs font-semibold text-charcoal/70 sm:inline-block">
          {site.subtitle}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden items-center gap-7 text-sm font-bold text-charcoal/85 lg:flex" aria-label="القائمة الرئيسية">
      <a href="/" class="relative py-1 transition hover:text-wood after:absolute after:bottom-0 after:right-0 after:h-0.5 after:w-0 after:bg-gold after:transition-all hover:after:w-full">
        الرئيسية
      </a>
      <a href="/#services" class="relative py-1 transition hover:text-wood after:absolute after:bottom-0 after:right-0 after:h-0.5 after:w-0 after:bg-gold after:transition-all hover:after:w-full">
        خدماتنا
      </a>
      <a href="/our-work/" class="relative py-1 transition hover:text-wood after:absolute after:bottom-0 after:right-0 after:h-0.5 after:w-0 after:bg-gold after:transition-all hover:after:w-full">
        أعمالنا
      </a>
      <a href="/#why-us" class="relative py-1 transition hover:text-wood after:absolute after:bottom-0 after:right-0 after:h-0.5 after:w-0 after:bg-gold after:transition-all hover:after:w-full">
        لماذا نحن
      </a>
      <a href="/#designs" class="relative py-1 transition hover:text-wood after:absolute after:bottom-0 after:right-0 after:h-0.5 after:w-0 after:bg-gold after:transition-all hover:after:w-full">
        أفكار وتصاميم
      </a>
      <a href="/#faq" class="relative py-1 transition hover:text-wood after:absolute after:bottom-0 after:right-0 after:h-0.5 after:w-0 after:bg-gold after:transition-all hover:after:w-full">
        الأسئلة الشائعة
      </a>
      <a href="/#contact" class="relative py-1 transition hover:text-wood after:absolute after:bottom-0 after:right-0 after:h-0.5 after:w-0 after:bg-gold after:transition-all hover:after:w-full">
        تواصل معنا
      </a>
    </nav>

    <!-- Desktop Call to Action Buttons -->
    <div class="hidden items-center gap-3 sm:flex">
      <a
        href={callLink}
        class="inline-flex items-center gap-2 rounded-full border border-wood/30 bg-transparent px-4 py-2 text-sm font-bold text-wood transition duration-200 hover:border-wood hover:bg-wood/5"
      >
        <svg class="h-4 w-4 text-wood" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>اتصل بنا</span>
      </a>

      <a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-[#1A7A4C] px-5 py-2 text-sm font-extrabold text-white shadow-sm transition duration-200 hover:bg-[#14603B] hover:shadow-md"
      >
        <svg class="h-4 w-4 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>واتساب</span>
      </a>
    </div>

    <!-- Mobile Header Quick CTA & Menu Button -->
    <div class="flex items-center gap-2 lg:hidden">
      <a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full bg-[#1A7A4C] px-3.5 py-1.5 text-xs font-bold text-white shadow-xs transition hover:bg-[#14603B] sm:hidden"
        aria-label="تواصل واتساب سريع"
      >
        <svg class="h-3.5 w-3.5 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>واتساب</span>
      </a>

      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-wood/20 bg-white p-2 text-charcoal shadow-xs transition hover:bg-ivory hover:text-wood focus:outline-none focus:ring-2 focus:ring-gold"
        aria-label="فتح القائمة الرئيسية"
        aria-expanded="false"
        aria-controls="mobile-menu-dropdown"
      >
        <svg id="menu-icon-bars" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-6 w-6 text-charcoal" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu (Directly beneath header, perfectly responsive) -->
  <div
    id="mobile-menu-dropdown"
    class="hidden border-t border-wood/10 bg-white px-4 pt-4 pb-6 shadow-2xl lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="قائمة الجوال">
      <a href="/" class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3 text-base font-extrabold text-charcoal transition hover:bg-ivory hover:text-wood">
        <span>الرئيسية</span>
        <span class="text-xs text-wood/60">←</span>
      </a>
      <a href="/#services" class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3 text-base font-extrabold text-charcoal transition hover:bg-ivory hover:text-wood">
        <span>خدماتنا</span>
        <span class="text-xs text-wood/60">←</span>
      </a>
      <a href="/our-work/" class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3 text-base font-extrabold text-charcoal transition hover:bg-ivory hover:text-wood">
        <span>أعمالنا المنفذة</span>
        <span class="text-xs text-wood/60">←</span>
      </a>
      <a href="/#why-us" class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3 text-base font-extrabold text-charcoal transition hover:bg-ivory hover:text-wood">
        <span>لماذا نحن</span>
        <span class="text-xs text-wood/60">←</span>
      </a>
      <a href="/#designs" class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3 text-base font-extrabold text-charcoal transition hover:bg-ivory hover:text-wood">
        <span>أفكار وتصاميم</span>
        <span class="text-xs text-wood/60">←</span>
      </a>
      <a href="/#faq" class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3 text-base font-extrabold text-charcoal transition hover:bg-ivory hover:text-wood">
        <span>الأسئلة الشائعة</span>
        <span class="text-xs text-wood/60">←</span>
      </a>
      <a href="/#contact" class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3 text-base font-extrabold text-charcoal transition hover:bg-ivory hover:text-wood">
        <span>تواصل معنا</span>
        <span class="text-xs text-wood/60">←</span>
      </a>
    </nav>

    <!-- Quick action buttons inside mobile dropdown -->
    <div class="mt-4 flex flex-col gap-2.5 border-t border-wood/10 pt-4">
      <a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#1A7A4C] py-3 text-sm font-black text-white shadow-xs transition hover:bg-[#14603B]"
      >
        <svg class="h-4 w-4 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>تواصل عبر واتساب</span>
      </a>

      <a
        href={callLink}
        class="flex w-full items-center justify-center gap-2 rounded-xl border border-wood/30 bg-ivory/60 py-3 text-sm font-black text-wood shadow-2xs transition hover:bg-wood hover:text-white"
      >
        <svg class="h-4 w-4 text-wood" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>اتصال هاتفي: {site.phoneDisplay}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const dropdown = document.getElementById('mobile-menu-dropdown');
  const navLinks = document.querySelectorAll('.mobile-nav-link');
  const iconBars = document.getElementById('menu-icon-bars');
  const iconClose = document.getElementById('menu-icon-close');

  function toggleMenu() {
    const isHidden = dropdown?.classList.contains('hidden');
    if (isHidden) {
      dropdown?.classList.remove('hidden');
      menuBtn?.setAttribute('aria-expanded', 'true');
      iconBars?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    } else {
      dropdown?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
      iconBars?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  }

  function closeMenu() {
    dropdown?.classList.add('hidden');
    menuBtn?.setAttribute('aria-expanded', 'false');
    iconBars?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  menuBtn?.addEventListener('click', toggleMenu);

  navLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
