---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'أركان الرياض للتصميم الداخلي والاستشارات. تصميم وتنفيذ وتركيب الديكورات في الرياض، وتوريد المواد لجميع مناطق المملكة.',
} = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F0E8" />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>
