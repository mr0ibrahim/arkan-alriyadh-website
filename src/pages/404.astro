---
import MainLayout from '../layouts/MainLayout.astro';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<MainLayout noindex title={`الصفحة غير موجودة | ${site.fullName}`} description={`الصفحة المطلوبة غير موجودة. عُد إلى الصفحة الرئيسية لاستعراض خدمات ${site.fullName}.`}><Header /><main class="mx-auto max-w-3xl px-5 py-32 text-center"><p class="mb-4 text-5xl font-extrabold text-wood">404</p><h1 class="mb-5 text-3xl font-extrabold">الصفحة غير موجودة</h1><p class="mb-8 leading-8 text-charcoal/65">قد يكون الرابط قد تغير. يمكنك العودة إلى الرئيسية واستعراض خدماتنا.</p><a href="/" class="rounded-full bg-wood px-8 py-4 font-bold text-white">العودة للرئيسية</a></main><Footer /></MainLayout>
