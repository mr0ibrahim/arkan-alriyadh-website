---
import MainLayout from '../layouts/MainLayout.astro';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout
  noindex
  title={`الصفحة غير موجودة (404) | ${site.fullName}`}
  description={`الصفحة المطلوبة غير موجودة. عُد إلى الصفحة الرئيسية لاستعراض خدمات وتصاميم ${site.fullName}.`}
>
  <Header />
  <main class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-4 py-24 text-center sm:px-6">
    <div class="mb-6 flex h-24 w-24 items-center justify-center rounded-3xl border border-gold/30 bg-white shadow-md">
      <span class="text-4xl font-black text-gold">404</span>
    </div>
    <h1 class="mb-4 text-3xl font-black text-charcoal sm:text-4xl">
      عذراً، الصفحة غير متوفرة
    </h1>
    <p class="mb-8 max-w-md text-base leading-relaxed text-charcoal/75 sm:text-lg">
      قد يكون الرابط قد تم نقله أو تغييره. يمكنك العودة إلى الصفحة الرئيسية واستكشاف أرقى خدمات الديكور والتشطيبات.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 rounded-full bg-wood px-8 py-4 font-black text-white shadow-md transition duration-200 hover:bg-charcoal hover:shadow-xl"
    >
      <span>العودة إلى الصفحة الرئيسية</span>
      <span aria-hidden="true">←</span>
    </a>
  </main>
  <Footer />
</MainLayout>
