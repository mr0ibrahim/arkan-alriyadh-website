---
import { site, contactLink, callLink } from '../data/site';
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import DesignGallery from '../components/DesignGallery.astro';
import OurWork from '../components/OurWork.astro';
import { services } from '../data/services';
import { gallery } from '../data/gallery';
const whatsappUrl = (service: string) => contactLink(service);
---
<MainLayout title={`${site.fullName} | شيبورد وباركيه ودهانات بالرياض`} description={`${site.fullName}؛ 12 عامًا من الخبرة في الشيبورد والباركيه والبانوهات ونعلات الفايبر والدهانات في الرياض، مع توريد المواد لجميع مناطق المملكة.`}>
  <Header />
  <main>
    <Hero />
    <section id="services" class="scroll-mt-24 bg-white py-20" aria-labelledby="services-heading">
      <div class="mx-auto max-w-7xl px-5">
        <div class="mb-11 text-center"><p class="mb-3 font-bold text-wood">خدماتنا</p><h2 id="services-heading" class="text-3xl font-extrabold text-charcoal md:text-4xl">حلول ديكور تُنفّذ بعناية</h2><p class="mx-auto mt-4 max-w-2xl leading-8 text-charcoal/65">من الفكرة إلى اللمسة الأخيرة، نختار معك التشطيبات والخامات التي تحقق التوازن بين الجمال والوظيفة.</p></div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => {
            const preview = gallery.find(image => image.category === service.id);
            return (
              <article class="group flex flex-col overflow-hidden rounded-3xl border border-wood/10 bg-ivory transition hover:-translate-y-1 hover:shadow-xl">
                {preview ? <img onerror="this.onerror=null;this.src='/images/painting-reference.svg'" src={preview.src} alt={preview.alt} width="1000" height="750" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" /> : <div class="aspect-[4/3] bg-gold/20" />}
                <div class="flex flex-1 flex-col p-6">
                  <p class="mb-2 text-xs font-bold text-wood">{service.shortDescription}</p>
                  <h3 class="mb-3 text-xl font-extrabold text-charcoal"><a href={`/services/${service.id}/`} class="hover:text-wood focus-visible:underline">{service.title}</a></h3>
                  <p class="mb-5 flex-1 leading-8 text-charcoal/70">{service.description}</p>
                  <a href={`/services/${service.id}/`} class="mb-4 w-fit text-sm font-extrabold text-wood underline underline-offset-4">تفاصيل الخدمة ←</a>
                  <a href={whatsappUrl(service.title)} target="_blank" rel="noopener noreferrer" class="w-fit border-b border-wood pb-1 font-bold text-wood hover:text-charcoal">استفسر عن الخدمة ←</a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
    <OurWork compact />
    <DesignGallery />
    <section class="bg-white py-16"><div class="mx-auto max-w-7xl px-5 text-center"><p class="mb-3 font-bold text-wood">نطاق خدماتنا</p><h2 class="mb-4 text-3xl font-extrabold">تنفيذ وتركيب في الرياض، وتوريد لمختلف مناطق المملكة</h2><p class="leading-8 text-charcoal/70">نقدّم خدمات التصميم والتنفيذ والتركيب داخل الرياض، مع إمكانية توريد المواد إلى مختلف مناطق المملكة. ننسّق المعاينة والمقاسات وخيارات التوريد وفق متطلبات كل مشروع.</p></div></section>
    <section id="contact" class="scroll-mt-24 bg-ivory py-20"><div class="mx-auto max-w-4xl px-5 text-center"><p class="mb-3 font-bold text-wood">تواصل معنا</p><h2 class="mb-6 text-3xl font-extrabold">لنحوّل فكرتك إلى مساحة متقنة</h2><p class="mb-8 leading-8 text-charcoal/70">أخبرنا بطبيعة المساحة والتشطيب الذي تتطلع إليه، وسنناقش معك الحلول المناسبة من حيث التصميم والخامات والتنفيذ.</p><div class="flex flex-wrap justify-center gap-3"><a href={whatsappUrl('الديكور الداخلي')} target="_blank" rel="noopener noreferrer" class="rounded-full bg-wood px-8 py-4 font-bold text-white hover:bg-charcoal">تواصل عبر واتساب</a><a href={callLink} class="rounded-full border border-wood px-8 py-4 font-bold text-wood hover:bg-wood hover:text-white">اتصل الآن</a></div></div></section>
  </main>
  <Footer />
  <FloatingContact />
</MainLayout>
