---
import Header from '../components/Header.astro';
import MainLayout from '../layouts/MainLayout.astro';

const services = [
  {
    number: '01',
    title: 'الشيبورد',
    description: 'تصاميم جدارية عصرية بتشطيبات متنوعة.',
  },
  {
    number: '02',
    title: 'باركيه الأرضيات',
    description: 'أرضيات أنيقة تتناسب مع مختلف المساحات.',
  },
  {
    number: '03',
    title: 'نعلات الفايبر',
    description: 'تفاصيل تشطيب دقيقة تمنح المكان مظهرًا متكاملًا.',
  },
  {
    number: '04',
    title: 'براويز الفوم (البانوهات)',
    description: 'لمسات جدارية كلاسيكية وعصرية حسب الطلب.',
  },
  {
    number: '05',
    title: 'الدهانات والديكورات',
    description: 'دهانات عادية وديكورية بألوان وتشطيبات متنوعة.',
  },
];

const whatsapp =
  'https://wa.me/966533340982?text=' +
  encodeURIComponent(
    'السلام عليكم، شاهدت موقع أركان الرياض وأرغب في الاستفسار عن خدمات الديكور.'
  );
---

<MainLayout title="أركان الرياض | التصميم الداخلي والديكور بالرياض">
  <header class="border-b border-wood/10 bg-ivory">
    <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-5">
      <a href="/" class="flex flex-col">
        <span class="text-xl font-extrabold text-wood">
          أركان الرياض
        </span>
        <span class="text-[11px] text-charcoal/70">
          للتصميم الداخلي والاستشارات
        </span>
      </a>

      <a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-wood px-5 py-3 text-sm font-bold text-white transition hover:bg-charcoal"
      >
        تواصل معنا
      </a>
    </nav>
  </header>

  <main>
    <section class="mx-auto grid min-h-[65vh] max-w-7xl items-center gap-10 px-5 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <p class="mb-5 font-bold text-wood">
          خبرة 12 عامًا في عالم الديكور
        </p>

        <h1 class="mb-6 text-4xl leading-relaxed font-extrabold text-charcoal md:text-5xl">
          مساحات أنيقة
          <span class="text-wood">بتفاصيل تصنع الفرق</span>
        </h1>

        <p class="mb-9 max-w-xl leading-9 text-charcoal/75">
          نقدم خدمات التصميم والتنفيذ والتركيب للديكورات الداخلية
          في الرياض، بما يشمل الشيبورد والباركيه ونعلات الفايبر
          والبراويز والدهانات، مع توريد المواد لجميع محافظات المملكة.
        </p>

        <div class="flex flex-wrap gap-3">
          <a
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-wood px-7 py-4 font-bold text-white transition hover:bg-charcoal"
          >
            استفسر عبر واتساب
          </a>

          <a
            href="#services"
            class="rounded-full border border-wood px-7 py-4 font-bold text-wood transition hover:bg-wood hover:text-white"
          >
            استعرض خدماتنا
          </a>
        </div>
      </div>

      <div class="flex min-h-80 items-center justify-center rounded-3xl border border-gold/30 bg-white/60 p-8 text-center shadow-sm">
        <div>
          <p class="mb-3 text-6xl font-extrabold text-wood">12</p>
          <p class="text-xl font-bold">عامًا من الخبرة</p>
          <p class="mt-3 text-sm text-charcoal/60">
            هنا ستظهر صورة الديكور الرئيسية
          </p>
        </div>
      </div>
    </section>

    <section id="services" class="bg-white py-20">
      <div class="mx-auto max-w-7xl px-5">
        <div class="mb-10 text-center">
          <p class="mb-3 font-semibold text-wood">
            خدماتنا
          </p>
          <h2 class="text-3xl font-extrabold">
            حلول متكاملة للديكور الداخلي
          </h2>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <article class="rounded-2xl border border-wood/10 bg-ivory p-7 transition hover:shadow-lg">
              <span class="text-sm font-extrabold text-wood">
                {service.number}
              </span>

              <h3 class="mt-5 mb-3 text-xl font-bold">
                {service.title}
              </h3>

              <p class="leading-8 text-charcoal/70">
                {service.description}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-20 text-center">
      <h2 class="mb-4 text-3xl font-extrabold">
        هل لديك تصميم ترغب في تنفيذه؟
      </h2>

      <p class="mb-8 text-charcoal/70">
        تواصل معنا لمناقشة احتياجاتك. المعاينة والقياسات بالاتفاق.
      </p>

      <a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block rounded-full bg-wood px-8 py-4 font-bold text-white transition hover:bg-charcoal"
      >
        تواصل عبر واتساب
      </a>
    </section>
  </main>

  <footer class="bg-charcoal px-5 py-10 text-center text-white">
    <p class="font-bold">أركان الرياض للتصميم الداخلي والاستشارات</p>
    <p class="mt-3 text-sm text-white/70">
      التصميم والتنفيذ والتركيب في الرياض | التوريد لجميع محافظات المملكة
    </p>

    <a href="tel:+966533340982" class="mt-4 inline-block text-gold">
      +966 53 334 0982
    </a>
  </footer>
</MainLayout>
