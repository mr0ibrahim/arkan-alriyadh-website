---
import { site, contactLink, callLink } from '../../data/site';
import type { GetStaticPaths } from 'astro';
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingContact from '../../components/FloatingContact.astro';
import { services, type Service } from '../../data/services';
import { gallery, type GalleryImage } from '../../data/gallery';

export const getStaticPaths = (() => {
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}) satisfies GetStaticPaths;

interface Props { service: Service; }
const { service } = Astro.props;
const photos: GalleryImage[] = gallery.filter((image) => image.category === service.id);
const cover = photos[0];
const others = services.filter((item) => item.id !== service.id);
const whatsapp = contactLink(service.title);
const description = `${service.description} تصميم وتنفيذ وتركيب في الرياض، وتوريد المواد لجميع محافظات المملكة. للاستفسار: 0533340982.`;
---
<MainLayout title={`${service.title} بالرياض | ${site.fullName}`} description={description}>
  <Header />
  <main>
    <nav aria-label="مسار التصفح" class="mx-auto max-w-7xl px-5 pt-7 text-sm text-charcoal/65">
      <a href="/" class="hover:text-wood">الرئيسية</a><span aria-hidden="true"> / </span>
      <a href="/#services" class="hover:text-wood">الخدمات</a><span aria-hidden="true"> / </span>
      <span aria-current="page" class="text-wood">{service.title}</span>
    </nav>

    <section class="mx-auto grid max-w-7xl items-center gap-10 px-5 py-12 lg:grid-cols-2 lg:py-20">
      <div>
        <p class="mb-4 font-bold text-wood">تصاميم حسب الطلب · الرياض</p>
        <h1 class="mb-6 text-4xl font-extrabold leading-relaxed text-charcoal md:text-5xl">{service.title}</h1>
        <p class="mb-4 text-lg font-semibold text-wood">{service.shortDescription}</p>
        <p class="mb-8 max-w-xl leading-9 text-charcoal/75">{service.description} نناقش معك الخيارات الملائمة للمساحة والخامات والتشطيب قبل التنفيذ.</p>
        <div class="flex flex-wrap gap-3">
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="rounded-full bg-wood px-7 py-4 font-bold text-white transition hover:bg-charcoal">استفسر عن الخدمة عبر واتساب</a>
          <a href={callLink} class="rounded-full border border-wood px-7 py-4 font-bold text-wood transition hover:bg-wood hover:text-white">اتصل الآن</a>
        </div>
      </div>
      <div class="overflow-hidden rounded-3xl bg-white shadow-lg shadow-wood/10">
        {cover ? <img onerror="this.onerror=null;this.src='/images/painting-reference.svg'" src={cover.src} alt={cover.alt} width="1100" height="825" decoding="async" fetchpriority="high" class="aspect-[4/3] w-full object-cover" /> : <div class="flex aspect-[4/3] items-center justify-center bg-gold/20 text-wood">صورة توضيحية قيد الإضافة</div>}
      </div>
    </section>

    <section class="bg-white py-16" aria-labelledby="samples-title">
      <div class="mx-auto max-w-7xl px-5">
        <p class="mb-3 text-center font-bold text-wood">إلهام حسب الطلب</p>
        <h2 id="samples-title" class="mb-4 text-center text-3xl font-extrabold">نماذج {service.title}</h2>
        <p class="mx-auto mb-9 max-w-3xl text-center leading-8 text-charcoal/65">الصور المعروضة استرشادية لتوضيح الأفكار والتشطيبات ولا تُنسب إلى أعمال نفذناها. تحدد التفاصيل والخامات بحسب طلب العميل.</p>
        {photos.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {photos.map((photo) => (
              <figure class="overflow-hidden rounded-2xl border border-wood/10 bg-ivory">
                <img onerror="this.onerror=null;this.src='/images/painting-reference.svg'" src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="1000" height="750" class="aspect-[4/3] w-full object-cover" />
                <figcaption class="p-5 font-semibold">{photo.title}</figcaption>
              </figure>
            ))}
          </div>
        ) : <p class="text-center text-charcoal/65">ستُضاف نماذج هذه الخدمة لاحقًا.</p>}
      </div>
    </section>

    <section class="bg-ivory py-16">
      <div class="mx-auto max-w-5xl px-5 text-center">
        <h2 class="mb-5 text-3xl font-extrabold">أين نقدم هذه الخدمة؟</h2>
        <p class="leading-9 text-charcoal/75">التصميم والتنفيذ والتركيب في الرياض، مع توريد المواد إلى جميع محافظات المملكة. المعاينة والمقاسات وتفاصيل الشحن بالاتفاق مع العميل.</p>
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="mt-8 inline-block rounded-full bg-wood px-8 py-4 font-bold text-white hover:bg-charcoal">تواصل معنا لطلب {service.title}</a>
      </div>
    </section>

    <section class="bg-white py-16" aria-labelledby="related-heading">
      <div class="mx-auto max-w-7xl px-5">
        <h2 id="related-heading" class="mb-8 text-2xl font-extrabold">استكشف خدمات أخرى</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {others.map((other) => (
            <a href={`/services/${other.id}/`} class="rounded-2xl border border-wood/15 bg-ivory p-5 transition hover:border-wood hover:shadow-md">
              <span class="font-bold text-charcoal">{other.title}</span>
              <span class="mt-2 block text-sm text-wood">عرض الخدمة ←</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingContact />
</MainLayout>
